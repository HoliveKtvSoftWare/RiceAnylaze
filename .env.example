# 复制成 .env 再按本机情况修改：cp .env.example .env
#
# .env 已被 .gitignore 忽略，**不要提交**（里面的库密码 / SECRET_KEY 属于凭据）。
# 必填项缺失会导致后端启动失败；未在此列出的键会被忽略（不会报错）。

# PostgreSQL 连接串（必须带 +asyncpg，HTTP 请求走异步引擎）
DATABASE_URL="postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/rice_analysis_db"

# Redis。当前启动链不使用 RQ，保留仅为兼容旧配置。
REDIS_URL="redis://localhost:6379/0"

# JWT 签名密钥。生成：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="CHANGE_ME"

# 文件存储根目录（会挂载到 /static，导出与预览图都在这下面）
STORAGE_PATH="./app_storage/user_data"

# 茎秆截面分割模型
YOLO_MODEL_PATH="./models_yolo/yolov8s-1.pt"

# 剑叶分割模型（默认权重）
LEAF_MODEL_PATH="./models_yolo/leaf-v11-p2-exp59.pt"

# SQLAlchemy SQL 日志（SQLAlchemy echo）。排查数据库问题时临时设 true。
DB_ECHO=false

# --- 旁路（sidecar）推理配置，通常无需修改，下面是代码里的默认值 ---
# 部分权重需要另一套 ultralytics，会在子进程里用这个解释器执行
# FORK_PYTHON="D:\\Anaconda\\envs\\yolo\\python.exe"
# FORK_PROJECT="./.ultra_refine"
# FORK_PYLIBS="./.pylibs"
# SIDECAR_SCRIPT="./deploy/runtime/sidecar_infer.py"
