# 默认加载的 YOLO 模型路径
YOLO_MODEL_PATH="./models_yolo/yolov8s-1.pt"

# 可用模型注册表：JSON 字符串，key 为前端传的 model_name，value 为模型文件路径
# 前端显示用 model_name，后端据此查表得到真实模型路径
YOLO_MODELS='{"yolov8s-1": "./models_yolo/yolov8s-1.pt", "yolov8n": "./models_yolo/yolov8n.pt", "yolov8m": "./models_yolo/yolov8m.pt"}'