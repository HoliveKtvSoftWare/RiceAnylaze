# PostgreSQL 数据库连接字符串
DATABASE_URL="postgresql+asyncpg://postgres:123456@localhost:5432/rice_analysis_db"

# Redis 连接字符串
REDIS_URL="redis://localhost:6379/0"

# JWT 安全密钥
SECRET_KEY="46bf6df7ff9f7fab398937637abf3acc02b9bbc7fa0e5ee5b4d3e29382747520"

# 文件存储路径
